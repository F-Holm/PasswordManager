{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 3
  },
  "include": [],
  "configurePresets": [
        {
            "name": "std-23",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_STANDARD": "23",
                "CMAKE_C_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        },
        {
            "name": "std",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_STANDARD_REQUIRED": true,
                "CMAKE_CXX_STANDARD_REQUIRED": true
            }
        },
        {
            "name": "no-std",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_STANDARD_REQUIRED": false,
                "CMAKE_CXX_STANDARD_REQUIRED": false
            }
        },
        {
            "name": "verbose",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_VERBOSE_MAKEFILE": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug_conf",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release_conf",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "color-output",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_COLOR_DIAGNOSTICS": true,
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "ninja",
            "hidden": true,
            "generator": "Ninja",
            "inherits": [
                "color-output"
            ]
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "default",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cmakeExecutable": "cmake",
            "inherits": [
                "ninja",
                "std",
                "std-23",
                "clang"
            ]
        },
        {
            "name": "release",
            "inherits": [
                "default",
                "release_conf"
            ]
        },
        {
            "name": "debug",
            "inherits": [
                "default",
                "debug_conf",
                "verbose"
            ]
        },
        {
            "name": "debug-asan",
            "displayName": "Debug + ASan + LSan + UBSan",
            "inherits": [
                "debug"
            ],
            "cacheVariables": {
                "ENABLE_ASAN": "ON",
                "ENABLE_LSAN": "ON",
                "ENABLE_UBSAN": "ON",
                "ENABLE_TSAN": "OFF"
            }
        },
        {
            "name": "debug-tsan",
            "displayName": "Debug + TSan",
            "inherits": [
                "debug"
            ],
            "cacheVariables": {
                "ENABLE_ASAN": "OFF",
                "ENABLE_LSAN": "OFF",
                "ENABLE_UBSAN": "OFF",
                "ENABLE_TSAN": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-release",
            "configurePreset": "release"
        },
        {
            "name": "build-debug",
            "configurePreset": "debug"
        },
        {
            "name": "build-debug-asan",
            "configurePreset": "debug-asan"
        },
        {
            "name": "build-debug-tsan",
            "configurePreset": "debug-tsan"
        }
    ],
    "testPresets": [
        {
            "name": "base-test",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "test-release",
            "configurePreset": "release",
            "configuration": "Release",
            "inherits": [
                "base-test"
            ]
        },
        {
            "name": "test-debug",
            "configurePreset": "debug",
            "configuration": "Debug",
            "inherits": [
                "base-test"
            ]
        },
        {
            "name": "test-debug-asan",
            "configurePreset": "debug-asan",
            "configuration": "Debug",
            "inherits": [
                "base-test"
            ]
        },
        {
            "name": "test-debug-tsan",
            "configurePreset": "debug-tsan",
            "configuration": "Debug",
            "inherits": [
                "base-test"
            ],
            "execution": {
                "timeout": 3600
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "wf-release",
            "steps": [
                { "type": "configure", "name": "release" },
                { "type": "build", "name": "build-release" },
                { "type": "test", "name": "test-release" }
            ]
        },
        {
            "name": "wf-debug",
            "steps": [
                { "type": "configure", "name": "debug" },
                { "type": "build", "name": "build-debug" },
                { "type": "test", "name": "test-debug" }
            ]
        },
        {
            "name": "wf-asan",
            "steps": [
                { "type": "configure", "name": "debug-asan" },
                { "type": "build", "name": "build-debug-asan" },
                { "type": "test", "name": "test-debug-asan" }
            ]
        },
        {
            "name": "wf-tsan",
            "steps": [
                { "type": "configure", "name": "debug-tsan" },
                { "type": "build", "name": "build-debug-tsan" },
                { "type": "test", "name": "test-debug-tsan" }
            ]
        }
    ]
}
