include_guard(GLOBAL)

# Runtime sanitizers (Clang/GCC, Debug builds only).
#
# Compatibility:
#   - ASan, LSan and UBSan can be combined (LSan is already part of ASan).
#   - TSan cannot be combined with ASan or LSan, so it needs its own build.
#   - UBSan can be combined with any of them.
#   - MSan is not supported yet.
#
# The runtime options of each enabled sanitizer are compiled into the test
# executables (see AddTests) through the __<sanitizer>_default_options()
# hooks the runtimes call at startup, so they apply whatever the CMake
# version and however the tests are run (ctest or the binary directly).
# The ASAN_OPTIONS/... environment variables still override them.
#
# SANITIZER_DEFAULT_OPTIONS_SOURCE is that generated C file, or empty when no
# sanitizer is enabled.

set(SANITIZER_DEFAULT_OPTIONS_SOURCE "")

function(_SanitizersValidate)
    if(ENABLE_TSAN AND (ENABLE_ASAN OR ENABLE_LSAN))
        message(FATAL_ERROR
            "Sanitizers: TSan cannot be combined with ASan or LSan. "
            "Use a separate build directory (e.g. `just sanitize tsan`).")
    endif()
    if(ENABLE_TSAN AND WIN32)
        message(FATAL_ERROR "Sanitizers: TSan is not supported on Windows")
    endif()
endfunction()

# Appends to `out_var` a C definition of __<name>_default_options()
# returning `options`.
function(_SanitizersHook out_var name options)
    set(_code
        "const char* __${name}_default_options(void)\;\n"
        "const char* __${name}_default_options(void) { return \"${options}\"\; }\n")
    string(CONCAT _code ${_code})
    set(${out_var} "${${out_var}}${_code}" PARENT_SCOPE)
endfunction()

macro(AddSanitizers)
    _SanitizersValidate()

    if(WIN32)
        if(ENABLE_ASAN OR ENABLE_LSAN OR ENABLE_UBSAN)
            message(STATUS "Sanitizers: Disabled on Windows")
        endif()
    else()
        set(_sanitizers "")
        set(_hooks "")

        # Apple's toolchain does not ship LeakSanitizer (neither standalone
        # nor as ASan's detect_leaks), so LSan is skipped there.
        set(_lsan "${ENABLE_LSAN}")
        if(_lsan AND APPLE)
            message(WARNING "Sanitizers: LSan is not supported on macOS, skipping it")
            set(_lsan OFF)
        endif()

        if(ENABLE_ASAN)
            list(APPEND _sanitizers address)
            add_compile_options(-fsanitize-address-use-after-scope)
            set(_asan_options
                "abort_on_error=1:strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1")
            if(_lsan)
                string(PREPEND _asan_options "detect_leaks=1:")
            endif()
            _SanitizersHook(_hooks asan "${_asan_options}")
        elseif(_lsan)
            list(APPEND _sanitizers leak)
        endif()

        if(_lsan)
            _SanitizersHook(_hooks lsan "report_objects=1")
        endif()

        if(ENABLE_UBSAN)
            list(APPEND _sanitizers undefined)
            if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
                list(APPEND _sanitizers integer nullability)
                add_compile_options(
                    "-fsanitize-ignorelist=${CMAKE_SOURCE_DIR}/cmake/ubsan_ignorelist.txt")
            endif()
            add_compile_options(-fno-sanitize-recover=all)
            _SanitizersHook(_hooks ubsan "print_stacktrace=1:halt_on_error=1")
        endif()

        if(ENABLE_TSAN)
            list(APPEND _sanitizers thread)
            _SanitizersHook(_hooks tsan
                "halt_on_error=1:second_deadlock_stack=1:suppressions=${CMAKE_SOURCE_DIR}/cmake/tsan_suppressions.txt")
        endif()

        if(_sanitizers)
            list(JOIN _sanitizers "," _sanitizer_list)
            message(STATUS "Sanitizers: -fsanitize=${_sanitizer_list}")
            add_compile_options("-fsanitize=${_sanitizer_list}" -fno-omit-frame-pointer)
            add_link_options("-fsanitize=${_sanitizer_list}")
            set(SANITIZER_DEFAULT_OPTIONS_SOURCE
                "${CMAKE_BINARY_DIR}/sanitizer_default_options.c")
            file(CONFIGURE OUTPUT "${SANITIZER_DEFAULT_OPTIONS_SOURCE}"
                CONTENT "/* Generated by cmake/Sanitizers.cmake. Do not edit. */\n${_hooks}"
                @ONLY)
        endif()
    endif()
endmacro()
